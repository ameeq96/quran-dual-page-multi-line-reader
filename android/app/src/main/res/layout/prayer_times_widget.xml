<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/prayer_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/prayer_widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/prayer_widget_title" android:textColor="#FFF8E6" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/prayer_widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#B8D1C4" android:textSize="10sp" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/prayer_widget_city" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/prayer_widget_setup" android:textColor="#B8D1C4" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/prayer_widget_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/prayer_widget_setup" android:textColor="#F0D895" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    <Chronometer android:id="@+id/prayer_widget_countdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B8D1C4" android:textSize="11sp" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/prayer_widget_name_fajr" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/prayer_widget_placeholder" android:textColor="#B8D1C4" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/prayer_widget_time_fajr" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/prayer_widget_placeholder" android:textColor="#FFF8E6" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/prayer_widget_name_dhuhr" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/prayer_widget_placeholder" android:textColor="#B8D1C4" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/prayer_widget_time_dhuhr" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/prayer_widget_placeholder" android:textColor="#FFF8E6" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/prayer_widget_name_asr" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/prayer_widget_placeholder" android:textColor="#B8D1C4" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/prayer_widget_time_asr" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/prayer_widget_placeholder" android:textColor="#FFF8E6" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/prayer_widget_name_maghrib" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/prayer_widget_placeholder" android:textColor="#B8D1C4" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/prayer_widget_time_maghrib" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/prayer_widget_placeholder" android:textColor="#FFF8E6" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/prayer_widget_name_isha" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/prayer_widget_placeholder" android:textColor="#B8D1C4" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/prayer_widget_time_isha" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/prayer_widget_placeholder" android:textColor="#FFF8E6" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/prayer_widget_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="5dp" android:text="@string/prayer_widget_refresh" android:textColor="#D4E6DB" android:textSize="11sp" android:paddingLeft="12dp" android:paddingRight="2dp" />
</LinearLayout>
